# All APIs used are FREE — no paid keys required.

# Ollama (runs locally, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Binance (optional, increases rate limits — works without key)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# CoinGecko (optional, increases rate limits — works without key)
COINGECKO_API_KEY=

# CryptoPanic (free at cryptopanic.com/developers — improves news quality)
CRYPTOPANIC_API_KEY=
