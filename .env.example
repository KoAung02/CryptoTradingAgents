# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Binance (optional, increases rate limits)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# CoinGecko (optional, free tier works without key)
COINGECKO_API_KEY=

# CryptoPanic (free at cryptopanic.com/developers)
CRYPTOPANIC_API_KEY=

# Paid APIs (leave blank to use mock data)
GLASSNODE_API_KEY=
SANTIMENT_API_KEY=
LUNARCRUSH_API_KEY=
MESSARI_API_KEY=
